# Copier ce fichier en .env et adapter si besoin

# Connexion PostgreSQL (correspond au docker-compose.yml fourni)
DATABASE_URL=postgresql://onja:onja_password@localhost:5433/doublons_db

# Origines autorisées pour le frontend (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seuils du moteur de rapprochement (0-100)
SEUIL_DOUBLON=85
SEUIL_INCERTAIN=60

# Taille max de fichier acceptée (en Mo)
AUTH_COOKIE_SECURE=false # true en production sous HTTPS
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
MAX_UPLOAD_SIZE_MO=50
